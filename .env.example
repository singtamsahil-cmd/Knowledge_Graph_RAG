NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_this_password
NEO4J_DATABASE=neo4j
SPACY_MODEL=en_core_web_lg
LOG_LEVEL=INFO
BACKUP_DIR=./backups
# Ollama runs LOCALLY on the host (not in Docker). LEAVE OLLAMA_BASE_URL UNSET:
# local code defaults to http://localhost:11434, containers default to
# http://host.docker.internal:11434 (see docker-compose.yml).
#OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# RAG provider: ollama-local (no key) or ollama-cloud (needs key below).
LLM_PROVIDER=ollama-local
CLOUD_MODEL=gemma4:31b
# CLOUD_BASE_URL=https://ollama.com/api
# OLLAMA_API_KEY=your_ollama_cloud_key_here
